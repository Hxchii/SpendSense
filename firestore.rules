rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each account's data lives under users/{uid} — the profile document
    // itself plus every domain subcollection (wallets, transactions,
    // budgets, savings_goals, recurring_bills, receipts, categories,
    // reminders, ai_chat). A signed-in user can only ever touch their own
    // subtree, and nothing else in the database is readable or writable.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
